generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role String @default("editor")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrf String
  expiresAt DateTime
  @@index([expiresAt])
}
model Content {
  id String @id @default(cuid())
  kind String
  slug String
  title String
  description String @default("")
  body String @default("")
  category String @default("")
  brand String @default("")
  model String @default("")
  image String @default("")
  imageAlt String @default("")
  datasheet String @default("")
  status String @default("draft")
  availability String @default("enquiry")
  demo Boolean @default(false)
  verified Boolean @default(false)
  featured Boolean @default(false)
  author String @default("")
  publishedAt DateTime?
  seoTitle String @default("")
  seoDescription String @default("")
  specifications Json @default("[]")
  applications String @default("")
  warranty String @default("")
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([kind, slug])
  @@index([kind, status, publishedAt])
}
model Enquiry {
  id String @id @default(cuid())
  kind String
  name String
  organisation String
  email String
  phone String
  country String @default("")
  category String @default("")
  interest String @default("")
  productId String @default("")
  quantity Int?
  message String
  consentAt DateTime @default(now())
  status String @default("new")
  emailStatus String @default("pending")
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
}
model Media {
  id String @id
  filename String
  url String
  mime String
  size Int
  alt String
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  userId String
  action String
  target String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
